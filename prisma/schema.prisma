// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ContentType: "DRAMA" | "MOVIE"
// DramaStatus: "ONGOING" | "COMPLETED" | "UPCOMING"
// UserRole: "ADMIN" | "USER"

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("ADMIN") // UserRole: "ADMIN" | "USER"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Genre {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique
  dramas Drama[]
}

model Drama {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  alternativeTitle String?
  synopsis         String
  posterUrl        String
  backdropUrl      String?
  type             String    @default("DRAMA") // ContentType: "DRAMA" | "MOVIE"
  status           String    @default("ONGOING") // DramaStatus: "ONGOING" | "COMPLETED" | "UPCOMING"
  country          String    @default("South Korea")
  releaseYear      Int
  totalEpisodes    Int?
  rating           Float?
  views            Int       @default(0)
  isFeatured       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  genres           Genre[]
  episodes         Episode[]

  @@index([slug])
  @@index([type])
  @@index([status])
  @@index([country])
}

model Episode {
  id            String   @id @default(cuid())
  episodeNumber Int
  title         String?
  releaseDate   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  dramaId       String
  drama         Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  servers       Server[]

  @@unique([dramaId, episodeNumber])
}

model Server {
  id            String   @id @default(cuid())
  serverName    String
  embedUrl      String
  quality       String   @default("HD") // "FHD" | "HD" | "SD"
  orderPriority Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  episodeId     String
  episode       Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}
